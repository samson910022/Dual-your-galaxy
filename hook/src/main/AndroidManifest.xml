<?xml version="1.0" encoding="utf-8"?>
<!-- LSPosed module declaration: manager meta-data only (no android:label). -->
<!-- D1 single-APK: :app is the only APK, so its "Galaxy Dual Plus" label wins; -->
<!-- this library manifest contributes just the xposed meta-data below. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Marks this APK as an Xposed module. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <!-- Minimum and target Xposed API versions (API 102). -->
        <meta-data
            android:name="xposedminapi"
            android:value="102" />
        <meta-data
            android:name="xposedtargetapi"
            android:value="102" />
        <meta-data
            android:name="xposeddescription"
            android:value="Galaxy Dual Plus hook: Samsung Dual whitelist extension (MIT, no Knox access)" />
        <!-- Recommended scopes; authoritative list is META-INF/xposed/scope.list. -->
        <meta-data
            android:name="xposedscope"
            android:value="system;com.samsung.android.da.daagent;com.galaxydual.plus;com.galaxydual.plus.debug" />
    </application>
</manifest>

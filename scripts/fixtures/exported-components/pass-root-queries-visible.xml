<?xml version="1.0" encoding="utf-8"?>
<!-- pass-root-queries-visible: a ROOT-level (<manifest>-child) <queries>
     block declaring package visibility, holding an <activity> pinned
     android:exported="true". A visibility declaration is NEVER a registered
     component, so an exported attribute inside a root <queries> is ignored
     entirely and the gate must PASS (with the 4 allowlisted components
     present). A <queries> nested anywhere else exempts nothing — see
     fail-application-nested-queries.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.samson910022.galaxydualplus.debug">
    <queries>
        <activity android:name="com.example.VisibilityShim"
            android:exported="true" />
    </queries>
    <application android:label="Dual your Galaxy">
        <activity android:name="com.galaxydual.plus.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="io.github.samson910022.galaxydualplus.debug.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <provider
            android:name="com.galaxydual.plus.GuardXposedProvider"
            android:authorities="io.github.samson910022.galaxydualplus.debug.XposedService"
            android:exported="true" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

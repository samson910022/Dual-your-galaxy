<?xml version="1.0" encoding="utf-8"?>
<!-- fail-unallowlisted-service: the 4 allowlisted components PLUS an
     exported <service> at an unpinned authority (com.example.EvilService).
     The service is not in the allowlist ⇒ the gate must fail. This is the
     primary new-surface tripwire for services. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.samson910022.galaxydualplus.debug">
    <application android:label="Dual your Galaxy">
        <activity android:name="com.galaxydual.plus.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="com.example.EvilService"
            android:exported="true" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="io.github.samson910022.galaxydualplus.debug.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <provider
            android:name="com.galaxydual.plus.GuardXposedProvider"
            android:authorities="io.github.samson910022.galaxydualplus.debug.XposedService"
            android:exported="true" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- fail-unallowlisted-provider: the 4 allowlisted components PLUS an
     exported <provider> at an unpinned authority (com.example.evil). Not in
     the allowlist ⇒ the gate must fail. New-surface tripwire for providers;
     the parity gate owns only the GuardXposedProvider authority. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.galaxydual.plus.debug">
    <application android:label="Galaxy Dual Plus">
        <activity android:name="com.galaxydual.plus.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name="com.example.EvilProvider"
            android:authorities="com.example.evil"
            android:exported="true" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.galaxydual.plus.debug.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <provider
            android:name="com.galaxydual.plus.GuardXposedProvider"
            android:authorities="com.galaxydual.plus.debug.XposedService"
            android:exported="true" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- fail-provider-path-permission: the allowlisted GuardXposedProvider
     carrying a <path-permission> child (pathPrefix /binder, pinned
     INTERACT_ACROSS_USERS_FULL). Path-scoped URI grants on an EXPORTED
     provider are the same data-egress class as android:grantUriPermissions ⇒
     the gate must fail, naming the provider. (With or without
     android:permission on the child — ANY <path-permission> child fails.) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.samson910022.galaxydualplus.debug">
    <application android:label="Galaxy Dual Plus">
        <activity android:name="com.galaxydual.plus.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="io.github.samson910022.galaxydualplus.debug.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <provider
            android:name="com.galaxydual.plus.GuardXposedProvider"
            android:authorities="io.github.samson910022.galaxydualplus.debug.XposedService"
            android:exported="true">
            <path-permission
                android:pathPrefix="/binder"
                android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        </provider>
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

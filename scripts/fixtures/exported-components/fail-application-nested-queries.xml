<?xml version="1.0" encoding="utf-8"?>
<!-- fail-application-nested-queries: a <queries> block nested INSIDE
     <application> is NOT a root (<manifest>-child) visibility declaration,
     so the exported <activity> inside it is an ordinary enumerated element.
     It is not allowlisted ⇒ the gate must fail. (Only a ROOT <queries>
     exempts; see pass-root-queries-visible.xml for the discriminating
     pass case.) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.samson910022.galaxydualplus.debug">
    <application android:label="Dual your Galaxy">
        <queries>
            <activity android:name="com.example.Nested"
                android:exported="true" />
        </queries>
        <activity android:name="com.galaxydual.plus.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="io.github.samson910022.galaxydualplus.debug.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <provider
            android:name="com.galaxydual.plus.GuardXposedProvider"
            android:authorities="io.github.samson910022.galaxydualplus.debug.XposedService"
            android:exported="true" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- fail-guard-added-permission: the allowlisted GuardXposedProvider WITH an
     android:permission it must never carry (pinned: absent). Its caller
     restriction is the UID gate in GuardXposedProvider.kt — manifest-level
     permission would break the LSPosed daemon call path ⇒ the gate must
     fail. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.galaxydual.plus.debug">
    <application android:label="Galaxy Dual Plus">
        <activity android:name="com.galaxydual.plus.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.galaxydual.plus.debug.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <provider
            android:name="com.galaxydual.plus.GuardXposedProvider"
            android:authorities="com.galaxydual.plus.debug.XposedService"
            android:exported="true"
            android:permission="com.example.EvilPermission" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

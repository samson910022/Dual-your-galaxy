<!-- App manifest: launcher activity plus Shizuku provider and dual-app permissions. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.galaxydual.plus">

    <!-- PR-7 P2 (#26) 權限審計結論 (見 docs/USAGE.md「權限」節): -->
    <!-- - QUERY_ALL_PACKAGES:保留。個人來源 catalog (SourceInventory.loadSourceApps 經 -->
    <!--   PackageManager.getInstalledApplications) 在 API 30+ 需此權限才能看到完整授權 -->
    <!--   可見列表；本 App 核心功能即列舉/管理已安裝套件。本專案經 GitHub sideload 發佈、 -->
    <!--   不上架 Play，不受 Play 該政策限制 (lint.xml 將 QueryAllPackagesPermission 降級)。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- - REQUEST_INSTALL_PACKAGES:已移除。程式碼庫無 PackageInstaller session / -->
    <!--   ACTION_INSTALL_PACKAGE / canRequestPackageInstalls 呼叫鏈；clone 路徑為 shell -->
    <!--   通道 `pm install-existing` (su/Shizuku)，不走安裝器會話，不諮詢此權限。 -->
    <!-- - MANAGE_EXTERNAL_STORAGE:已移除。無共享儲存暫存：APK 不落地、無 -->
    <!--   getExternalStorage/MediaStore/DownloadManager 呼叫；寫入通道僅經 shell 命令。 -->
    <!-- Shizuku shell channel (independent of LSPosed marker; hook signal never enters routing). -->
    <uses-permission android:name="moe.shizuku.manager.permission.APIV2" />

    <!-- allowBackup=false：無備份需求，排除 dual_selection (SharedPreferences) 上雲；
         選取僅本機持久化，重裝即失效符合 fail-closed。 -->
    <!-- Do NOT add android:sharedUserId: uid-equality gate (ShizukuCmdGateway.isAllowedCaller) would admit sibling packages; redesign gate first. ShizukuProvider is not a trust boundary for GalaxyExecService. -->
    <application
        android:name=".GalaxyApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Galaxy Dual Plus"
        android:supportsRtl="true"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku binder provider; required for Shizuku API V2 to attach. -->
        <!-- Shizuku-mandated exported provider: the Shizuku manager binds this authority,
             access is gated by INTERACT_ACROSS_USERS_FULL plus the user's Shizuku grant;
             never reuse this provider/authority for private app data. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Stage2 (hook-policy-source P1):移除 libxposed service AAR 合併進來
             的 XposedProvider (同 authority ${applicationId}.XposedService)。
             原宣告 exported 且無權限,任何 app 皆可呼叫 SendBinder 交付假
             IBinder 劫持政策通道;改以守衛版取代 (見下一節點)。
             註:tools:node="replace" 對不同名節點無效 (merger 以 name 配對,
             會產生 duplicate authority),故以 remove + 宣告為可靠做法。 -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            tools:node="remove" />

        <!-- 守衛版 provider:同一 authority,但只信任 LSPosed daemon
             (僅 root(0)/system(1000)/self，shell 拒絕——其 callingUid 由
              kernel 設定、一般 app 無法偽造),見 GuardXposedProvider。
             Threat model: this exported provider accepts SendBinder only from
              root (uid 0) / system (uid 1000, appId 1000) / the app itself;
              every other caller — including shell (2000) — is rejected with
              null. The checked UID is the kernel-set Binder.getCallingUid(),
              never a caller-supplied value. -->
        <provider
            android:name=".GuardXposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>

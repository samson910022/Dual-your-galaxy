<!-- Phase UI P1: explicit disabled state (state_enabled=false) so disabled
     batch/clone/refresh buttons read as unavailable instead of tappable.
     Light disabled: oneui_disabled_text #475569 on oneui_disabled_bg
     #D2DEEB = 5.55 (AA); night version swaps tokens (see drawable-night). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/oneui_disabled_bg" />
            <corners android:radius="9999dp" />
        </shape>
    </item>
    <item>
        <ripple
            android:color="@color/oneui_primary_tint">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/oneui_primary" />
                    <corners android:radius="9999dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>

<!-- Phase UI P1: explicit disabled state (state_enabled=false). Same gray
     tokens as bg_pill_button so remove/clone rows read consistently. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/oneui_disabled_bg" />
            <corners android:radius="9999dp" />
            <stroke
                android:width="1dp"
                android:color="@color/oneui_disabled_stroke" />
        </shape>
    </item>
    <item>
        <ripple
            android:color="@color/oneui_stroke_subtle">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/white" />
                    <corners android:radius="9999dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/oneui_surface_container_high" />
                    <corners android:radius="9999dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/oneui_stroke_subtle" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>

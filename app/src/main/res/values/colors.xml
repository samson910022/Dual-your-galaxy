<!-- p28-1 語意色（淺色，預設白底 #FFFFFF）：一般文字對比一律至少 4.5:1。
     - msg_invalid #8A5200（6.39:1）取代舊橙色（白底僅約 4.24:1，未達 4.5:1，見 #28）。
     - msg_no_dual #7A5600（6.65:1，舊色雖 4.69:1 達標但餘裕小，一併加深）。
     - 其餘沿用現行色（白底：INFO 7.09（#166627 實測值）、VERIFY/FAILED 7.33、CHANNEL 9.39，皆達標）。
     完整主題為 p28-3 範圍，此處只定義訊息語意色，不做全 App 主題。 -->
<resources>
    <color name="msg_info">#166627</color>
    <color name="msg_invalid">#8A5200</color>
    <color name="msg_no_dual">#7A5600</color>
    <color name="msg_verify">#B00020</color>
    <color name="msg_failed">#B00020</color>
    <color name="msg_channel">#6A1B9A</color>
</resources>
